{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:static",
  "outputDirectory": "dist/public",
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/publications", "destination": "/publications.html" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/resources", "destination": "/resources.html" },
    { "source": "/membership", "destination": "/membership.html" }
  ]
}
